{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econmark.local/spec/grading-input.schema.json",
  "title": "EconMark grading input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "mode",
    "student_ref",
    "question_text",
    "command_word",
    "max_mark",
    "mark_scheme_text",
    "answer_images",
    "confirmed_transcript",
    "language",
    "schema_version"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["public_sample", "account_upload"] },
    "student_ref": { "type": "string", "minLength": 1, "maxLength": 80 },
    "question_text": { "type": "string", "minLength": 1 },
    "command_word": { "enum": ["Analyse", "Discuss"] },
    "max_mark": { "enum": [6, 8] },
    "mark_scheme_text": { "type": "string", "minLength": 1 },
    "mark_scheme_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "answer_images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_id", "name", "mime_type", "page"],
        "properties": {
          "image_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "mime_type": { "enum": ["image/jpeg", "image/png", "image/webp", "application/pdf", "image/svg+xml"] },
          "page": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string" },
          "validation_flags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "confirmed_transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "version", "teacher_confirmed", "confirmation_method", "transcription_confidence", "uncertain_spans"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "teacher_confirmed": { "type": "boolean" },
        "confirmation_method": { "enum": ["teacher", "auto_gated"] },
        "transcription_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "uncertain_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "page", "line"],
            "properties": {
              "text": { "type": "string" },
              "page": { "type": "integer", "minimum": 1 },
              "line": { "type": "integer", "minimum": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "confirmation_method": { "const": "teacher" } }, "required": ["confirmation_method"] },
          "then": { "properties": { "teacher_confirmed": { "const": true } } }
        },
        {
          "if": { "properties": { "confirmation_method": { "const": "auto_gated" } }, "required": ["confirmation_method"] },
          "then": { "properties": { "teacher_confirmed": { "const": false } } }
        }
      ]
    },
    "language": { "const": "en_zh" },
    "schema_version": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "command_word": { "const": "Analyse" } } },
      "then": { "properties": { "max_mark": { "const": 6 } } }
    },
    {
      "if": { "properties": { "command_word": { "const": "Discuss" } } },
      "then": { "properties": { "max_mark": { "const": 8 } } }
    }
  ]
}
