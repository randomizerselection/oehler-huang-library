ECONMARK_HOST=127.0.0.1
ECONMARK_PORT=4173
ECONMARK_DATA_DIR=/var/lib/econmark
ECONMARK_COOKIE_SECURE=true
ECONMARK_SESSION_DAYS=30
ECONMARK_MAX_FILE_MB=32
ECONMARK_MAX_BATCH_SIZE=100
ECONMARK_MAX_BATCH_TOTAL_MB=512
ECONMARK_BATCH_CONCURRENCY=4
ECONMARK_MAX_REQUEST_MB=64
ECONMARK_MAX_ACCOUNT_STORAGE_GB=50
ECONMARK_LOGIN_ATTEMPTS_PER_15_MINUTES=12
ECONMARK_GRADING_REQUESTS_PER_HOUR=150
ECONMARK_TEACHER_INVITE_CODE=replace-with-a-long-random-school-invite

ECONMARK_DEFAULT_PROVIDER=qwen
ECONMARK_TRANSCRIPTION_PROVIDER=qwen
ECONMARK_TRANSCRIPTION_MODEL=qwen3-vl-plus
ECONMARK_RUBRIC_PROVIDER=qwen
ECONMARK_PRIMARY_PROVIDER=qwen
ECONMARK_REVIEWER_PROVIDER=deepseek
ECONMARK_ADJUDICATOR_PROVIDER=qwen
ECONMARK_FEEDBACK_PROVIDER=qwen

DASHSCOPE_API_KEY=replace-me
DEEPSEEK_API_KEY=replace-me
MOONSHOT_API_KEY=
