[Unit]
Description=EconMark account-based Economics grading service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=econmark
Group=econmark
WorkingDirectory=/opt/econmark
EnvironmentFile=/etc/econmark/econmark.env
ExecStart=/usr/bin/node scripts/serve.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/econmark
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
