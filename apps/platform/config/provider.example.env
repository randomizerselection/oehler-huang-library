# Choose a default provider for every role, then override individual roles below.
ECONMARK_DEFAULT_PROVIDER=qwen

# Recommended first benchmark configuration.
ECONMARK_TRANSCRIPTION_PROVIDER=qwen
ECONMARK_TRANSCRIPTION_MODEL=qwen3-vl-plus
ECONMARK_RUBRIC_PROVIDER=qwen
ECONMARK_RUBRIC_MODEL=qwen3.7-max-2026-05-20
ECONMARK_PRIMARY_PROVIDER=qwen
ECONMARK_PRIMARY_MODEL=qwen3.7-max-2026-05-20
ECONMARK_REVIEWER_PROVIDER=deepseek
ECONMARK_REVIEWER_MODEL=deepseek-v4-pro
ECONMARK_ADJUDICATOR_PROVIDER=qwen
ECONMARK_ADJUDICATOR_MODEL=qwen3.7-max-2026-05-20
ECONMARK_FEEDBACK_PROVIDER=qwen
ECONMARK_FEEDBACK_MODEL=qwen-flash

# Supply only the keys for providers selected above. Never put these values in browser code.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Optional controls.
ECONMARK_OCR_AUTO_GATE_MIN=0.97
ECONMARK_PROVIDER_TIMEOUT_MS=120000
ECONMARK_PROVIDER_MAX_ATTEMPTS=2

# Application, account, and permanent-storage controls.
ECONMARK_HOST=127.0.0.1
ECONMARK_PORT=4173
ECONMARK_DATA_DIR=/var/lib/econmark
ECONMARK_COOKIE_SECURE=true
ECONMARK_SESSION_DAYS=30
ECONMARK_LOGIN_ATTEMPTS_PER_15_MINUTES=12
ECONMARK_GRADING_REQUESTS_PER_HOUR=150
# Required only when creating new teacher accounts. Existing pre-v4 accounts migrate to teacher.
ECONMARK_TEACHER_INVITE_CODE=

# All limits are server-side and can be changed without rebuilding the UI.
ECONMARK_MAX_FILE_MB=32
ECONMARK_MAX_BATCH_SIZE=100
ECONMARK_MAX_BATCH_TOTAL_MB=512
ECONMARK_BATCH_CONCURRENCY=4
ECONMARK_MAX_REQUEST_MB=64
ECONMARK_MAX_ACCOUNT_STORAGE_GB=50
